<header class="top">
  <div class="bar">
    <button
      type="button"
      class="brand"
      id="home"
      aria-label="<%= brand %> — show all notes"
    >
      <i aria-hidden="true">✎</i><span><%= brand %></span>
    </button>
    <div class="search">
      <input
        id="q"
        type="search"
        placeholder="Search title, keyword or #tag…  ( / )"
        aria-label="Search notes"
        autocomplete="off"
      />
    </div>
    <button class="icon" id="theme" aria-label="Switch theme"></button>
    <button class="btn primary" id="newBtn">+ New note</button>
  </div>
</header>
