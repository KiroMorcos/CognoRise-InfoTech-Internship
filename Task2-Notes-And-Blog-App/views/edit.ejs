<%- include("partials/header") %>

<h2>Edit Post</h2>

<form action="/update/<%= post.id %>" method="POST">

<input
type="text"
name="title"
value="<%= post.title %>"
required
>

<textarea
name="content"
required
><%= post.content %></textarea>

<button>Update</button>

</form>

<%- include("partials/footer") %>