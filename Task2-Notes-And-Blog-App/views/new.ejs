<%- include('partials/header') %>

<div class="form-container">
    <h2>✨ Create New Note</h2>
    <form action="/new" method="POST" class="note-form" id="note-form">
        <div class="form-group">
            <label for="title">Title</label>
            <input type="text" id="title" name="title" required maxlength="100" placeholder="Note title...">
            <div class="char-counter"><span id="title-count">0</span>/100</div>
        </div>

        <div class="form-group">
            <label for="description">Description</label>
            <textarea id="description" name="description" required rows="6" maxlength="1000" placeholder="Write your note or blog content here..."></textarea>
            <div class="char-counter"><span id="desc-count">0</span>/1000</div>
        </div>

        <div class="form-group">
            <label for="tags">Tags (comma separated)</label>
            <input type="text" id="tags" name="tags" placeholder="e.g. javascript, nodejs, ideas">
        </div>

        <div class="form-group checkbox-group">
            <label>
                <input type="checkbox" name="pinned"> Pin this note to the top 📌
            </label>
        </div>

        <div class="form-actions">
            <button type="submit" class="btn btn-primary">Save Note</button>
            <a href="/" class="btn btn-secondary">Cancel</a>
        </div>
    </form>
</div>

<script>
    const titleInput = document.getElementById('title');
    const descInput = document.getElementById('description');
    const titleCount = document.getElementById('title-count');
    const descCount = document.getElementById('desc-count');

    titleInput.addEventListener('input', () => {
        titleCount.textContent = titleInput.value.length;
    });

    descInput.addEventListener('input', () => {
        descCount.textContent = descInput.value.length;
    });
</script>

<%- include('partials/footer') %>