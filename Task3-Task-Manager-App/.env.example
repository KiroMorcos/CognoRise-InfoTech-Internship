# Copy to .env and fill in. Never commit .env.
NODE_ENV=development
PORT=3000
MONGODB_URI=mongodb://127.0.0.1:27017/taskflow

# Generate each with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_ACCESS_SECRET=replace-with-a-long-random-string
JWT_REFRESH_SECRET=replace-with-a-different-long-random-string

ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_DAYS=7

# Only needed if the front-end is served from a different origin (comma-separated)
# CLIENT_ORIGIN=http://localhost:5173

# ---- E-mail reminders (due dates and timers left running) ----
# Public address of the app, used for the link inside the e-mails
APP_URL=http://localhost:3000
# Any SMTP account works (Gmail: smtp.gmail.com, port 587, and an "App password"). Without SMTP_HOST the e-mails are printed in the console instead of sent.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM=TaskFlow <your-address@example.com>
# Set to false to switch all e-mail reminders off
EMAIL_NOTIFICATIONS=true
# Send a due-date reminder when this many hours are left (comma separated). 72,24 = 3 days before and 1 day before
DUE_REMINDER_HOURS=72,24
# Remind the user every N hours while a timer keeps running (3 = after 3 h, 6 h, 9 h…)
TIMER_REMINDER_HOURS=3
# How often the server checks, in minutes
NOTIFY_INTERVAL_MINUTES=5
